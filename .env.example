# Local-only settings. Never commit this file or put keys in the frontend.
# GitHub Actions secrets are not available in your Docker container.
TZ=Europe/Lisbon
UID=1000
GID=1000
FINANCE_PORT=5052
# Default LAN access; set 127.0.0.1 to expose only via host/reverse proxy.
FINANCE_BIND_HOST=0.0.0.0
FINANCE_DATA_DIR=./data-local

# The optional FRED key enables authenticated official observations.
FRED_API_KEY=

# Set your Wisesheets API key HERE for monthly collection inside the container.
# The existing bundled audited snapshot remains readable without a key.
WISESHEETS_API_KEY=

# Optional daily 24 instrument/3 FX refresh (off for macro-first dashboard).
FINANCE_INCLUDE_MARKETS=0

# Daily consistent online SQLite backups retained under the /data volume.
FINANCE_AUTO_BACKUP=1
FINANCE_BACKUP_KEEP=14

# ALFRED genuine month-end source snapshots (requires FRED_API_KEY). Historical
# monthly backfill is a separate bounded CLI command, not an HTTP browser action.
FINANCE_VINTAGE_REFRESH=1

# SEC N-PORT holdings: OFF unless the actual fund CIK and SEC series IDs have
# been verified and placed into /data/holdings/sec_funds.json. Use a real contact
# email in SEC_USER_AGENT for compliant EDGAR access.
FINANCE_SEC_HOLDINGS_REFRESH=0
SEC_USER_AGENT=

# OECD forbids API access via VPN/anonymized networks. Leave 0 until you have
# verified this Docker container's outbound network is direct and permitted.
# Setting 1 is an operator assertion, not automatic VPN detection.
FINANCE_OECD_DIRECT_NETWORK_ACK=0

# All external source clients share a durable publisher policy ledger inside
# the existing /data volume; there is no separate scheduler or rate-limit DB.
# /api/source-policy shows effective catalog constraints and cooldown states.
