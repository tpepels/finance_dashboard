# Copy to .env and set a unique value. Keep .env outside version control.
# Avoid characters with special meaning in a SQL connection URL unless percent-encoded.
POSTGRES_PASSWORD=change_this_to_a_long_random_password

# FRED API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Optional; without it FRED series report credentials_required and are not fetched.
FRED_API_KEY=
# Optional unreliable public CSV fallback; never enabled by default.
FRED_PUBLIC_CSV_FALLBACK=0
